# =====================================================================
# Frontend environment configuration (Vite)
# =====================================================================
# Both variables are OPTIONAL for local development.
#
#   * Local dev:  the Vite dev server proxies /api to http://localhost:8000
#                 and the WebSocket /api/ws to the same origin. Leaving the
#                 variables unset keeps the existing workflow intact.
#
#   * Production: set both to the Render backend URL so the Vercel-hosted
#                 frontend can reach the FastAPI service over HTTPS / WSS.
#                 Example:
#                   VITE_API_BASE_URL=https://agentic-company-simulator.onrender.com
#                   VITE_WS_BASE_URL=wss://agentic-company-simulator.onrender.com
# =====================================================================

# REST API base. Must NOT include a trailing "/api" — the API client
# appends "/api" automatically. Do not point this at localhost in
# production builds.
VITE_API_BASE_URL=

# WebSocket base. Must be ws:// or wss:// + host. The hook appends
# "/api/ws/companies/<id>" automatically. Do not point this at localhost
# in production builds.
VITE_WS_BASE_URL=
