# --- Application ---
PROJECT_NAME=Agent Company Simulator
API_PREFIX=/api
ENVIRONMENT=development

# --- Database ---
# Default points at a local PostgreSQL instance (see docker-compose.yml).
# For local development without Postgres you may use SQLite, e.g.:
#   DATABASE_URL=sqlite:///./agent_company.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_company

# --- CORS (comma-separated origins served by the frontend dev server) ---
# In production, set this to your actual frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
# Set to DEBUG for development, INFO for production.
LOG_LEVEL=INFO

# --- LLM configuration (never hardcoded) ---
LLM_PROVIDER=noop  # noop | mock | anthropic | openai
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30  # seconds
LLM_MAX_RETRIES=2
