# =====================================================================
# Agent Company Simulator — Backend environment configuration
# =====================================================================
# Copy this file to ".env" for local development and edit values there.
# Production secrets (Render / Neon) MUST be set via the platform's
# environment-variable UI, NEVER by committing a populated .env file.
# =====================================================================

# --- Application ---
PROJECT_NAME=Agent Company Simulator
API_PREFIX=/api
# Set to "production" on Render so the app can tighten logging etc.
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
# Local: use the docker-compose stack (default value below).
# Production: paste the Neon connection string, e.g.
#   DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_company

# --- CORS ---
# Comma-separated list of origins allowed to call the API. The frontend
# on Vercel is the only client in production. Example:
#   CORS_ORIGINS=https://agentic-company-simulator.vercel.app
# Local development defaults are kept here so `pytest` / `uvicorn` work
# out of the box without extra configuration.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
# Set to DEBUG for development, INFO (or WARNING) for production.
LOG_LEVEL=INFO

# --- LLM configuration (never hardcoded) ---
# Provider used by the simulation engine. Local/offline providers (noop, mock,
# ollama) run without external services; cloud providers need credentials.
LLM_PROVIDER=noop  # noop | mock | anthropic | openai | gemini | ollama
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# Base URL for a locally running Ollama server (used only when
# LLM_PROVIDER=ollama). Override only for a local Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Provider examples — uncomment / copy the block that matches your setup.
# Local dev with no external LLM:
#   LLM_PROVIDER=noop        (or LLM_PROVIDER=mock for scripted decisions)
#
# Cloud: Anthropic
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#
# Cloud: OpenAI
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#
# Cloud: Google Gemini (uses LLM_API_KEY as the Gemini API key)
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-2.5-flash
#   LLM_API_KEY=<your-gemini-api-key>
#
# Local: Ollama (no API key required)
#   LLM_PROVIDER=ollama
#   LLM_MODEL=<local-model>        # e.g. gemma2, llama3
#   LLM_API_KEY=                    # not required for ollama
#   OLLAMA_BASE_URL=http://localhost:11434
# ---------------------------------------------------------------------------
