# --- Application ---
PROJECT_NAME=Agent Company Simulator
API_PREFIX=/api
ENVIRONMENT=development

# --- Database ---
# Default points at a local PostgreSQL instance (see docker-compose.yml).
# For local development without Postgres you may use SQLite, e.g.:
#   DATABASE_URL=sqlite:///./agent_company.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_company

# --- CORS (comma-separated origins served by the frontend dev server) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
